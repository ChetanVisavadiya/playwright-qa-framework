{
  "name": "playwright-qa-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test automation framework: UI (Page Object Model) and API (typed client with schema/contract checks), CI-ready.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium --project=firefox",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps chromium firefox"
  },
  "keywords": ["playwright", "typescript", "test-automation", "api-testing", "page-object-model", "qa"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
